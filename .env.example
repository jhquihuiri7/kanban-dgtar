# ── PostgreSQL ───────────────────────────────────────────────────────────
# docker-compose lee este archivo automáticamente. deploy.sh lo copia a .env
# si no existe. .env está en .gitignore.

POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
POSTGRES_PORT=5433
APP_PORT=8001

# Desarrollo aislado con hot reload. Comparte la misma PostgreSQL de producción.
DEV_APP_PORT=3000
DEV_APP_PUBLIC_URL=http://localhost:3000
DEV_GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── ngrok opcional para OAuth público ────────────────────────────────────
# Crea un authtoken en https://dashboard.ngrok.com/get-started/your-authtoken
# y colócalo solo en .env. Nunca lo subas al repositorio.
NGROK_AUTHTOKEN=

# API/dashboard local de ngrok. Solo se publica en 127.0.0.1.
NGROK_WEB_PORT=4040

# Opcional: URL fija/reservada de ngrok, por ejemplo:
#   NGROK_URL=https://tu-dominio.ngrok.app
# Si queda vacío, ngrok asigna una URL HTTPS dinámica.
NGROK_URL=

# Target interno al que ngrok enviará tráfico.
# Por defecto usa el puerto publicado del host Docker:
#   http://host.docker.internal:8001
# Si cambias APP_PORT, ajusta este valor o deja que deploy.sh use APP_PORT.
NGROK_TARGET=

# Opcional: fuerza URLs públicas absolutas en la app cuando uses una URL fija.
# Con URL dinámica, déjalo vacío y entra a la app desde la URL pública de ngrok.
NGROK_APP_PUBLIC_URL=
NGROK_GOOGLE_REDIRECT_URI=
NGROK_AUTH_COOKIE_SECURE=true


# Conexión usada por la app.
# Dentro de Docker, docker-compose la sobreescribe al host "db".
# Este valor (localhost) sirve para correr `npm run dev` en tu máquina
# apuntando al PostgreSQL dockerizado.
DATABASE_URL=postgres://kanban:kanban@localhost:5433/kanban

# Firma de cookies de sesión. Cambia este valor en producción.
AUTH_SECRET=change-this-secret-in-production

# Como no usamos Nginx/HTTPS por ahora, queda en false para acceder por HTTP.
AUTH_COOKIE_SECURE=false

# ── Google Calendar ───────────────────────────────────────────────────────
# Crea credenciales OAuth 2.0 tipo "Web application" en Google Cloud y autoriza
# este callback. En desarrollo con `npm run dev` normalmente sera:
#   http://localhost:3000/api/google/callback
# En modo ngrok, autoriza:
#   https://TU-DOMINIO-NGROK/api/google/callback
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Clave para cifrar refresh tokens de Google en PostgreSQL. Usa un secreto largo
# distinto en produccion.
GOOGLE_TOKEN_ENCRYPTION_KEY=change-this-google-token-encryption-key

# Tu modelo de reuniones no guarda duracion todavia; Google necesita inicio y fin.
GOOGLE_DEFAULT_EVENT_DURATION_MINUTES=60
