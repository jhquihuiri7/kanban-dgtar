# ── PostgreSQL ───────────────────────────────────────────────────────────
# docker-compose lee este archivo automáticamente. deploy.sh lo copia a .env
# si no existe. .env está en .gitignore.

POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
POSTGRES_PORT=5433
APP_PORT=8001


# Conexión usada por la app.
# Dentro de Docker, docker-compose la sobreescribe al host "db".
# Este valor (localhost) sirve para correr `npm run dev` en tu máquina
# apuntando al PostgreSQL dockerizado.
DATABASE_URL=postgres://kanban:kanban@localhost:5433/kanban

# Firma de cookies de sesión. Cambia este valor en producción.
AUTH_SECRET=change-this-secret-in-production

# Como no usamos Nginx/HTTPS por ahora, queda en false para acceder por HTTP.
AUTH_COOKIE_SECURE=false

# ── Google Calendar ───────────────────────────────────────────────────────
# Crea credenciales OAuth 2.0 tipo "Web application" en Google Cloud y autoriza
# este callback. En desarrollo con `npm run dev` normalmente sera:
#   http://localhost:3000/api/google/callback
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Clave para cifrar refresh tokens de Google en PostgreSQL. Usa un secreto largo
# distinto en produccion.
GOOGLE_TOKEN_ENCRYPTION_KEY=change-this-google-token-encryption-key

# Tu modelo de reuniones no guarda duracion todavia; Google necesita inicio y fin.
GOOGLE_DEFAULT_EVENT_DURATION_MINUTES=60
